---
const posts = await Astro.glob('../content/posts/*.md');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>The JoCo Watch | Independent Johnson County Newsroom</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
      :root {
        --brand-blue: #0A66C2;
        --brand-dark: #0F172A;
        --bg-body: #FAFAFA;
        --border-light: #E2E8F0;
        --text-main: #1E293B;
        --text-muted: #64748B;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: 'Inter', -apple-system, sans-serif;
        background-color: var(--bg-body);
        color: var(--text-main);
        line-height: 1.6;
      }

      .top-bar {
        background: #fff;
        border-bottom: 1px solid var(--border-light);
        padding: 0.5rem 1.5rem;
        font-size: 0.8rem;
        color: var(--text-muted);
      }

      .top-bar-container {
        max-width: 1100px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      header {
        background: #ffffff;
        border-bottom: 2px solid var(--brand-dark);
        padding: 2.5rem 1.5rem 1.5rem;
        text-align: center;
      }

      .brand-title {
        font-size: 2.75rem;
        font-weight: 800;
        letter-spacing: -0.04em;
        color: var(--brand-dark);
        text-transform: uppercase;
        margin-bottom: 0.5rem;
        text-decoration: none;
        display: inline-block;
      }

      .brand-title span { color: var(--brand-blue); }

      .tagline {
        font-family: 'Newsreader', serif;
        font-size: 1.15rem;
        font-style: italic;
        color: var(--text-muted);
        max-width: 650px;
        margin: 0 auto 1.5rem;
      }

      .nav-categories {
        display: flex;
        justify-content: center;
        gap: 2rem;
        border-top: 1px solid var(--border-light);
        padding-top: 1rem;
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .nav-categories a {
        color: var(--text-main);
        text-decoration: none;
      }

      .nav-categories a:hover { color: var(--brand-blue); }

      .container {
        max-width: 1100px;
        margin: 2.5rem auto;
        padding: 0 1.5rem;
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 3rem;
      }

      @media (max-width: 768px) {
        .container { grid-template-columns: 1fr; }
      }

      .section-heading {
        font-size: 0.85rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--brand-blue);
        border-bottom: 2px solid var(--brand-blue);
        padding-bottom: 0.4rem;
        margin-bottom: 1.5rem;
      }

      .posts-feed {
        display: flex;
        flex-direction: column;
        gap: 2rem;
      }

      .article-card {
        background: #ffffff;
        border: 1px solid var(--border-light);
        border-radius: 8px;
        padding: 1.75rem;
        transition: box-shadow 0.2s ease, border-color 0.2s ease;
        text-decoration: none;
        color: inherit;
        display: block;
      }

      .article-card:hover {
        border-color: var(--brand-blue);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
      }

      .article-meta {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--brand-blue);
        text-transform: uppercase;
        margin-bottom: 0.5rem;
        display: flex;
        gap: 0.5rem;
      }

      .article-meta span { color: var(--text-muted); font-weight: 400; }

      .article-title {
        font-family: 'Newsreader', serif;
        font-size: 1.8rem;
        font-weight: 600;
        line-height: 1.25;
        color: var(--brand-dark);
        margin-bottom: 0.75rem;
      }

      .article-summary {
        font-size: 0.95rem;
        color: var(--text-main);
        line-height: 1.6;
      }

      .sidebar-box {
        background: #ffffff;
        border: 1px solid var(--border-light);
        border-radius: 8px;
        padding: 1.5rem;
        margin-bottom: 2rem;
      }

      .sidebar-title {
        font-size: 1rem;
        font-weight: 700;
        color: var(--brand-dark);
        margin-bottom: 0.75rem;
      }

      .sidebar-text {
        font-size: 0.9rem;
        color: var(--text-muted);
        line-height: 1.5;
        margin-bottom: 1rem;
      }

      .contact-email {
        font-weight: 600;
        color: var(--brand-blue);
        text-decoration: none;
        font-size: 0.9rem;
      }
    </style>
  </head>
  <body>

    <div class="top-bar">
      <div class="top-bar-container">
        <span>Johnson County, Kansas</span>
        <span>Independent Community Newsroom</span>
      </div>
    </div>

    <header>
      <div class="masthead">
        <a href="/" class="brand-title">THE JOCO <span>WATCH</span></a>
        <p class="tagline">Clear, careful reporting on public safety, crime, courts, and local government across Johnson County.</p>
        
        <nav class="nav-categories">
          <a href="/">All Articles</a>
          <a href="#">Public Safety</a>
          <a href="#">Courts & Crime</a>
          <a href="#">City Issues</a>
          <a href="#">Deep Dives</a>
        </nav>
      </div>
    </header>

    <div class="container">
      <main>
        <div class="section-heading">Latest Reporting</div>

        {posts.length === 0 ? (
          <p style="color: var(--text-muted);">No reporting published yet.</p>
        ) : (
          <div class="posts-feed">
            {posts.map((post) => (
              <a href={post.url} class="article-card">
                <div class="article-meta">
                  PUBLIC SAFETY <span>• {post.frontmatter.date || 'Recent'}</span>
                </div>
                <h2 class="article-title">{post.frontmatter.title}</h2>
                <p class="article-summary">{post.frontmatter.summary}</p>
              </a>
            ))}
          </div>
        )}
      </main>

      <aside>
        <div class="sidebar-box">
          <h3 class="sidebar-title">About The JoCo Watch</h3>
          <p class="sidebar-text">
            We cover public safety and local stories across Johnson County. Not real-time breaking news—just clear, careful reporting.
          </p>
        </div>

        <div class="sidebar-box">
          <h3 class="sidebar-title">Tips & Story Ideas</h3>
          <p class="sidebar-text">
            Have a story or local issue we should investigate? Reach out directly to our team.
          </p>
          <a href="mailto:thejocowatch@gmail.com" class="contact-email">thejocowatch@gmail.com →</a>
        </div>
      </aside>
    </div>

  </body>
</html>

---
import Layout from '../layouts/Layout.astro';

const allPosts = await Astro.glob('../content/posts/*.md');
const now = new Date();

// STRICT BOOLEAN PARSING:
const featuredPost = allPosts.find(post => {
  const val = post.frontmatter.featured;
  const isTrue = val === true || val === 'true' || val === 'True';
  if (!isTrue) return false;

  if (post.frontmatter.feature_until) {
    const expireDate = new Date(post.frontmatter.feature_until);
    if (now > expireDate) return false;
  }
  return true;
});

// Non-featured posts go into regular feed
const feedPosts = allPosts.filter(post => post !== featuredPost);

const categoryMap = {
  'public-safety': 'Public Safety',
  'courts-crime': 'Courts & Crime',
  'city-issues': 'City Issues',
  'deep-dives': 'Deep Dives'
};
---

<Layout title="The JoCo Watch | Independent Johnson County Newsroom" activeTab="featured">
  <style>
    .section-heading { font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: var(--brand-blue); border-bottom: 2px solid var(--brand-blue); padding-bottom: 0.4rem; margin-bottom: 1.5rem; }
    .featured-card { background: #ffffff; border: 2px solid var(--brand-blue); border-radius: 8px; padding: 1.5rem; margin-bottom: 2.5rem; text-decoration: none; color: inherit; display: block; }
    .featured-badge { background: var(--brand-blue); color: #fff; font-size: 0.7rem; font-weight: 800; padding: 0.2rem 0.5rem; border-radius: 4px; text-transform: uppercase; margin-bottom: 0.5rem; display: inline-block; }
    .featured-title { font-family: 'Newsreader', serif; font-size: 2.2rem; font-weight: 700; color: var(--brand-dark); margin-bottom: 0.5rem; line-height: 1.2; }
    .featured-byline { font-size: 0.8rem; font-weight: 600; color: var(--text-muted); margin-bottom: 0.75rem; }
    .featured-img { width: 100%; max-height: 380px; object-fit: cover; border-radius: 6px; margin: 1rem 0; border: 1px solid var(--border-light); }

    .posts-feed { display: flex; flex-direction: column; gap: 1.5rem; }
    .article-card { background: #ffffff; border: 1px solid var(--border-light); border-radius: 8px; padding: 1.25rem 1.5rem; text-decoration: none; color: inherit; display: grid; grid-template-columns: 1fr 140px; gap: 1.5rem; align-items: center; }
    .article-card:hover { border-color: var(--brand-blue); box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05); }
    .article-meta { font-size: 0.75rem; font-weight: 700; color: var(--brand-blue); text-transform: uppercase; margin-bottom: 0.2rem; }
    .byline { font-size: 0.75rem; font-weight: 600; color: var(--text-muted); margin-bottom: 0.4rem; }
    .article-title { font-family: 'Newsreader', serif; font-size: 1.4rem; font-weight: 600; color: var(--brand-dark); margin-bottom: 0.4rem; }
    .article-summary { font-size: 0.88rem; color: var(--text-muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .thumbnail { width: 140px; height: 100px; object-fit: cover; border-radius: 6px; border: 1px solid var(--border-light); background-color: #f1f5f9; }
  </style>

  {featuredPost && (
    <div>
      <div class="section-heading">Featured Story</div>
      <a href={`/posts/${featuredPost.file.split('/').pop().replace('.md', '')}`} class="featured-card">
        <span class="featured-badge">FEATURED REPORT</span>
        <h2 class="featured-title">{featuredPost.frontmatter.title}</h2>
        <div class="featured-byline">Written by: Umbrellaman • {featuredPost.frontmatter.date ? String(featuredPost.frontmatter.date).split('T')[0] : 'Recent'}</div>
        {featuredPost.frontmatter.image && <img src={featuredPost.frontmatter.image} class="featured-img" alt="" />}
        <p style="color: var(--text-muted);">{featuredPost.frontmatter.summary}</p>
      </a>
    </div>
  )}

  <div class="section-heading">Latest Reporting</div>
  
  <div class="posts-feed">
    {feedPosts.map((post) => {
      const slug = post.file.split('/').pop().replace('.md', '');
      const catLabel = categoryMap[post.frontmatter.category] || 'Courts & Crime';
      const cleanDate = post.frontmatter.date ? String(post.frontmatter.date).split('T')[0] : 'Recent';
      return (
        <a href={`/posts/${slug}`} class="article-card">
          <div>
            <div class="article-meta">{catLabel} • {cleanDate}</div>
            <div class="byline">Written by: Umbrellaman</div>
            <h2 class="article-title">{post.frontmatter.title || slug.replace(/-/g, ' ')}</h2>
            <p class="article-summary">{post.frontmatter.summary || 'Click to read reporting...'}</p>
          </div>
          {post.frontmatter.image && <img src={post.frontmatter.image} alt="" class="thumbnail" />}
        </a>
      );
    })}
  </div>
</Layout>

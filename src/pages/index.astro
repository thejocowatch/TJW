---
import Layout from '../layouts/Layout.astro';

const allPosts = await Astro.glob('../content/posts/*.md');
const now = new Date();

// Helper: Check if an article is active (not auto-archived)
function isArticleActive(post) {
  if (post.frontmatter.archive_after) {
    const archiveDate = new Date(post.frontmatter.archive_after);
    if (now > archiveDate) return false; // Auto-archived!
  }
  return true;
}

// Filter ONLY articles explicitly marked featured AND active
const featuredPosts = allPosts.filter(post => {
  if (!isArticleActive(post)) return false;

  const val = post.frontmatter.featured;
  const isTrue = val === true || val === 'true' || val === 'True';
  if (!isTrue) return false;

  if (post.frontmatter.feature_until) {
    const expireDate = new Date(post.frontmatter.feature_until);
    if (now > expireDate) return false;
  }
  return true;
});
---

<Layout title="The JoCo Watch | Independent Johnson County Newsroom" activeTab="featured">
  <style>
    .section-heading { font-size: 0.85rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: var(--brand-blue); border-bottom: 2px solid var(--brand-blue); padding-bottom: 0.4rem; margin-bottom: 1.5rem; }
    .featured-card { background: #ffffff; border: 2px solid var(--brand-blue); border-radius: 8px; padding: 1.5rem; margin-bottom: 2rem; text-decoration: none; color: inherit; display: block; transition: box-shadow 0.2s ease; }
    .featured-card:hover { box-shadow: 0 6px 20px rgba(10, 102, 194, 0.12); }
    .featured-badge { background: var(--brand-blue); color: #fff; font-size: 0.7rem; font-weight: 800; padding: 0.2rem 0.5rem; border-radius: 4px; text-transform: uppercase; margin-bottom: 0.5rem; display: inline-block; }
    .featured-title { font-family: 'Newsreader', serif; font-size: 2.2rem; font-weight: 700; color: var(--brand-dark); margin-bottom: 0.5rem; line-height: 1.2; }
    .featured-byline { font-size: 0.8rem; font-weight: 600; color: var(--text-muted); margin-bottom: 0.75rem; }
    .featured-img { width: 100%; max-height: 380px; object-fit: cover; border-radius: 6px; margin: 1rem 0; border: 1px solid var(--border-light); }
    .no-featured { color: var(--text-muted); font-size: 0.95rem; background: #fff; padding: 2rem; border-radius: 8px; border: 1px solid var(--border-light); }
  </style>

  <div class="section-heading">Featured Stories</div>

  {featuredPosts.length === 0 ? (
    <div class="no-featured">
      There are currently no featured stories. Check out our category tabs above or visit the <a href="/archive" style="color: var(--brand-blue); font-weight: 600; text-decoration: underline;">Archive</a> to see all reporting.
    </div>
  ) : (
    featuredPosts.map((post) => {
      const slug = post.file.split('/').pop().replace('.md', '');
      const cleanDate = post.frontmatter.date ? String(post.frontmatter.date).split('T')[0] : 'Recent';
      return (
        <a href={`/posts/${slug}`} class="featured-card">
          <span class="featured-badge">FEATURED REPORT</span>
          <h2 class="featured-title">{post.frontmatter.title}</h2>
          <div class="featured-byline">Written by: Umbrelllaman • {cleanDate}</div>
          {post.frontmatter.image && <img src={post.frontmatter.image} class="featured-img" alt="" />}
          <p style="color: var(--text-muted);">{post.frontmatter.summary}</p>
        </a>
      );
    })
  )}
</Layout>

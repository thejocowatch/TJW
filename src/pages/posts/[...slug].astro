---
export async function getStaticPaths() {
  const posts = await Astro.glob('../../content/posts/*.md');
  return posts.map(post => {
    const slug = post.file.split('/').pop().replace('.md', '');
    return {
      params: { slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content } = post;

const categoryMap = {
  'public-safety': 'Public Safety',
  'courts-crime': 'Courts & Crime',
  'city-issues': 'City Issues',
  'deep-dives': 'Deep Dives'
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post.frontmatter.title || 'Article'} | The JoCo Watch</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      :root {
        --brand-blue: #0A66C2;
        --brand-dark: #0F172A;
        --bg-body: #FAFAFA;
        --border-light: #E2E8F0;
        --text-main: #1E293B;
        --text-muted: #64748B;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'Inter', sans-serif; background: var(--bg-body); color: var(--text-main); line-height: 1.7; }
      header { background: #fff; border-bottom: 2px solid var(--brand-dark); padding: 1.5rem; text-align: center; }
      .brand-title { font-size: 2rem; font-weight: 800; color: var(--brand-dark); text-decoration: none; text-transform: uppercase; }
      .brand-title span { color: var(--brand-blue); }
      .article-container { max-width: 780px; margin: 3rem auto; padding: 2.5rem; background: #fff; border: 1px solid var(--border-light); border-radius: 8px; }
      .meta { font-size: 0.85rem; font-weight: 700; color: var(--brand-blue); text-transform: uppercase; margin-bottom: 0.25rem; }
      .byline { font-size: 0.85rem; font-weight: 600; color: var(--text-muted); margin-bottom: 1.25rem; }
      h1 { font-family: 'Newsreader', serif; font-size: 2.5rem; line-height: 1.2; color: var(--brand-dark); margin-bottom: 1rem; }
      .summary { font-size: 1.15rem; color: var(--text-muted); font-style: italic; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-light); padding-bottom: 1.25rem; }
      .article-image { width: 100%; max-height: 480px; object-fit: cover; border-radius: 8px; margin: 1rem 0 2rem; border: 1px solid var(--border-light); }
      .content { font-size: 1.05rem; color: #334155; }
      .content p { margin-bottom: 1.25rem; }
      .back-btn { display: inline-block; margin-bottom: 1.5rem; color: var(--brand-blue); text-decoration: none; font-weight: 600; font-size: 0.9rem; }
    </style>
  </head>
  <body>
    <header>
      <a href="/" class="brand-title">THE JOCO <span>WATCH</span></a>
    </header>
    <div class="article-container">
      <a href="/" class="back-btn">← Back to Homepage</a>
      <div class="meta">{categoryMap[post.frontmatter.category] || 'COURTS & CRIME'} • {post.frontmatter.date || 'Recent'}</div>
      <div class="byline">Written by: Eric Collins</div>
      <h1>{post.frontmatter.title || 'Untitled Article'}</h1>
      
      {post.frontmatter.summary && <p class="summary">{post.frontmatter.summary}</p>}
      
      {/* Display article featured image inside the post */}
      {post.frontmatter.image && (
        <img src={post.frontmatter.image} alt={post.frontmatter.title} class="article-image" />
      )}

      <div class="content">
        <Content />
      </div>
    </div>
  </body>
</html>

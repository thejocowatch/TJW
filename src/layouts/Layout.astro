---
interface Props {
  title: string;
  activeTab?: string;
}

const { title, activeTab = '' } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    
    <!-- Favicon Links -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
      :root { --brand-blue: #0A66C2; --brand-dark: #0F172A; --bg-body: #FAFAFA; --border-light: #E2E8F0; --text-main: #1E293B; --text-muted: #64748B; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      
      html, body { 
        max-width: 100vw; 
        overflow-x: hidden; 
        font-family: 'Inter', -apple-system, sans-serif; 
        background-color: var(--bg-body); 
        color: var(--text-main); 
        line-height: 1.6; 
      }
      
      .top-bar { background: #fff; border-bottom: 1px solid var(--border-light); padding: 0.5rem 1rem; font-size: 0.8rem; color: var(--text-muted); }
      .top-bar-container { max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; }

      .weather-bug {
        background: rgba(15, 23, 42, 0.04);
        border: 1px solid var(--border-light);
        border-radius: 12px;
        padding: 0.2rem 0.65rem;
        font-size: 0.78rem;
        font-weight: 500;
        color: #475569;
        display: inline-flex;
        align-items: center;
      }

      header { background: #ffffff; border-bottom: 2px solid var(--brand-dark); padding: 1.25rem 1rem 0; position: relative; }
      .header-wrap { max-width: 1100px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; position: relative; }
      
      .header-logo { position: absolute; left: 0; top: 0; height: 90px; width: auto; max-width: 180px; object-fit: contain; }
      
      .header-contacts { position: absolute; right: 0; top: 5px; display: flex; flex-direction: column; align-items: flex-end; gap: 0.25rem; font-size: 0.82rem; font-weight: 600; }
      .header-contacts a { color: var(--text-muted); text-decoration: none; display: flex; align-items: center; gap: 0.35rem; transition: color 0.15s ease; }
      .header-contacts a:hover { color: var(--brand-blue); }
      
      .tip-btn { color: var(--brand-blue) !important; font-weight: 700; text-transform: uppercase; font-size: 0.78rem; letter-spacing: 0.03em; }

      .brand-title { font-size: 2.2rem; font-weight: 800; color: var(--brand-dark); text-transform: uppercase; text-decoration: none; display: inline-block; text-align: center; line-height: 1.1; }
      .brand-title span { color: var(--brand-blue); }
      .tagline { font-family: 'Newsreader', serif; font-size: 1rem; font-style: italic; color: var(--text-muted); max-width: 650px; text-align: center; margin: 0.5rem auto 1.25rem; }

      /* MOBILE SCROLLABLE NAVIGATION */
      .nav-categories { 
        display: flex; 
        justify-content: flex-start; 
        align-items: center;
        gap: 1.5rem; 
        border-top: 1px solid var(--border-light); 
        padding: 0.85rem 0; 
        font-size: 0.82rem; 
        font-weight: 700; 
        text-transform: uppercase; 
        width: 100%; 
        overflow-x: auto;
        white-space: nowrap;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
      }

      .nav-categories::-webkit-scrollbar {
        display: none;
      }

      .nav-categories a { 
        color: var(--text-main); 
        text-decoration: none; 
        flex-shrink: 0;
        padding-bottom: 2px;
      }
      
      .nav-categories a:hover, .nav-categories a.active { 
        color: var(--brand-blue); 
        border-bottom: 2px solid var(--brand-blue); 
      }

      .container { max-width: 1100px; margin: 1.5rem auto; padding: 0 1rem; display: grid; grid-template-columns: 1fr; gap: 2rem; }
      
      .sidebar-box { background: #ffffff; border: 1px solid var(--border-light); border-radius: 8px; padding: 1.25rem; margin-bottom: 1.5rem; }
      .newsletter-box { background: #F8FAFC; border: 1px solid #CBD5E1; }

      /* DESKTOP BREAKPOINT (768px+) */
      @media (min-width: 768px) {
        header { padding: 1.5rem 1.5rem 0; }
        .header-logo { height: 110px; max-width: 220px; }
        .brand-title { font-size: 2.75rem; }
        .tagline { font-size: 1.15rem; margin: 0.5rem auto 1.5rem; }
        
        .nav-categories {
          justify-content: center;
          gap: 2rem;
          font-size: 0.85rem;
          padding: 1rem 0;
          overflow-x: visible;
        }

        .container { margin: 2.5rem auto; padding: 0 1.5rem; grid-template-columns: 2fr 1fr; gap: 3rem; }
        .sidebar-box { padding: 1.5rem; }
      }

      /* MOBILE HEADER STACKING (<768px) */
      @media (max-width: 767px) { 
        .header-logo, .header-contacts { position: static; margin-bottom: 0.75rem; align-items: center; } 
        .header-contacts { flex-direction: row; flex-wrap: wrap; justify-content: center; gap: 0.75rem; }
      }
    </style>
  </head>
  <body>
    <div class="top-bar">
      <div class="top-bar-container">
        <span>Johnson County, KS • Independent Newsroom</span>
        <div class="weather-bug">
          <span id="weather-temp">Current temp --°F</span>
        </div>
      </div>
    </div>

    <header>
      <div class="header-wrap">
        <a href="/"><img src="/logo.png" alt="The JoCo Watch Logo" class="header-logo" onerror="this.style.display='none'" /></a>
        
        <div class="header-contacts">
          <a href="mailto:thejocowatch@gmail.com?subject=News%20Tip%20%2F%20Story%20Idea" class="tip-btn">
            <span>Submit a Tip / Story Idea 📩</span>
          </a>
          <a href="https://www.facebook.com/profile.php?id=61592711402958" target="_blank" rel="noopener">
            <span>Facebook Page ↗</span>
          </a>
          <a href="mailto:thejocowatch@gmail.com">
            <span>thejocowatch@gmail.com</span>
          </a>
        </div>

        <a href="/" class="brand-title">THE JOCO <span>WATCH</span></a>
        <p class="tagline">Clear, careful reporting on public safety, crime, courts, and local government across Johnson County.</p>

        <nav class="nav-categories">
          <a href="/" class={activeTab === 'featured' ? 'active' : ''}>Featured</a>
          <a href="/public-safety" class={activeTab === 'public-safety' ? 'active' : ''}>Public Safety</a>
          <a href="/courts-crime" class={activeTab === 'courts-crime' ? 'active' : ''}>Courts & Crime</a>
          <a href="/city-issues" class={activeTab === 'city-issues' ? 'active' : ''}>City Issues</a>
          <a href="/deep-dives" class={activeTab === 'deep-dives' ? 'active' : ''}>Deep Dives</a>
          <a href="/archive" class={activeTab === 'archive' ? 'active' : ''}>Archive</a>
        </nav>
      </div>
    </header>

    <div class="container">
      <main>
        <slot />
      </main>

      <aside>
        <div class="sidebar-box">
          <h3 style="font-size: 1rem; font-weight: 700; margin-bottom: 0.75rem;">About The JoCo Watch</h3>
          <p style="font-size: 0.9rem; color: var(--text-muted);">We cover public safety and local stories across Johnson County. Not real-time breaking news—just clear, careful reporting.</p>
        </div>

        <div class="sidebar-box newsletter-box">
          <h3 style="font-size: 0.95rem; font-weight: 700; color: var(--brand-dark); margin-bottom: 0.5rem;">Get Email Alerts</h3>
          <p style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 1rem;">Receive an instant notification in your inbox whenever new reporting is published.</p>
          
          <script async src="https://eocampaign1.com/form/9a8d8d82-8eff-11f1-88bd-97bdd1745cef.js" data-form="9a8d8d82-8eff-11f1-88bd-97bdd1745cef"></script>
        </div>
      </aside>
    </div>

    <script>
      async function fetchTemp() {
        try {
          const res = await fetch('https://api.open-meteo.com/v1/forecast?latitude=38.98&longitude=-94.67&current_weather=true&temperature_unit=fahrenheit');
          const data = await res.json();
          if (data && data.current_weather) {
            const temp = Math.round(data.current_weather.temperature);
            const el = document.getElementById('weather-temp');
            if (el) el.textContent = `Current temp ${temp}°F`;
          }
        } catch (e) {
          console.error(e);
        }
      }
      fetchTemp();
    </script>
  </body>
</html>
